{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".*\\.int-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "setupFiles": ["reflect-metadata"],
  "globalSetup": "<rootDir>/integration/global-setup.ts",
  "testEnvironment": "node",
  "testTimeout": 60000,
  "forceExit": true
}
